{
  "name": "mtart-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json",
    "catalogue": "node scripts/build-catalogue.mjs",
    "vectorize": "python ../../../tools/vectorize-moulds/vectorize.py",
    "moulds": "node scripts/build-catalogue.mjs && python ../../../tools/vectorize-moulds/vectorize.py",
    "test": "vitest run",
    "cf:dev": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "d1:migrate:local": "wrangler d1 migrations apply mtart-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply mtart-db --remote",
    "d1:seed-sql": "node scripts/generate-d1-catalog-seed.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.8.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.28.0",
    "@cloudflare/workers-types": "^5.20260811.1"
  }
}
