{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  },
  "Otlp": {
    "Endpoint": ""
  },
  "Seq": {
    "Url": ""
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}" }
      },
      "catalog-swagger": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "catalog-swagger-root": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/swagger" }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/identity/{**catch-all}" }
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": { "Path": "/api/v1/content/{**catch-all}" }
      },
      "inquiry-route": {
        "ClusterId": "inquiry-cluster",
        "Match": { "Path": "/api/v1/inquiries/{**catch-all}" }
      },
      "contact-route": {
        "ClusterId": "inquiry-cluster",
        "Match": { "Path": "/api/v1/contact" }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/api/v1/media/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": { "destination1": { "Address": "http://catalog-api:8080/" } }
      },
      "identity-cluster": {
        "Destinations": { "destination1": { "Address": "http://identity-api:8080/" } }
      },
      "content-cluster": {
        "Destinations": { "destination1": { "Address": "http://content-api:8080/" } }
      },
      "inquiry-cluster": {
        "Destinations": { "destination1": { "Address": "http://inquiry-api:8080/" } }
      },
      "media-cluster": {
        "Destinations": { "destination1": { "Address": "http://media-api:8080/" } }
      }
    }
  }
}
