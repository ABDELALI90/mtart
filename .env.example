# Copy this file to ".env" (same folder as docker-compose.yml) and replace every
# placeholder before running `docker compose up`. Never commit the real ".env" file.

# ---------------------------------------------------------------------------
# SQL Server (one server, one database per microservice - see docs/architecture.md)
# ---------------------------------------------------------------------------
SQLSERVER_SA_PASSWORD=Ch4nge_Me_Str0ng_Pwd!
SQLSERVER_PORT=1433

# ---------------------------------------------------------------------------
# Redis (read-through cache for navigation/catalog/settings)
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# RabbitMQ (integration events: QuotationRequested, ProductPublished, ...)
# ---------------------------------------------------------------------------
RABBITMQ_USER=mtart
RABBITMQ_PASSWORD=Ch4nge_Me_Str0ng_Pwd!
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage for product/project media in dev)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=mtart
MINIO_ROOT_PASSWORD=Ch4nge_Me_Str0ng_Pwd!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=mtart-media

# ---------------------------------------------------------------------------
# Gateway / CORS
# ---------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
GATEWAY_PORT=8080
WEB_PORT=5173

# ---------------------------------------------------------------------------
# Identity / JWT - generate a real random 32+ char secret per environment.
# Never reuse this value in staging/production.
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_use_a_random_32_plus_character_signing_key
JWT_ISSUER=https://mtart.example.com
JWT_AUDIENCE=mtart-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# ---------------------------------------------------------------------------
# Observability (optional - leave blank to disable Seq/OTLP export locally)
# ---------------------------------------------------------------------------
OTLP_ENDPOINT=
SEQ_URL=

# ---------------------------------------------------------------------------
# Notifications / contact form (Gmail: use an App Password, not the mailbox password)
# Local Development: prefer .NET User Secrets on Inquiry.Api (never commit the password):
#   dotnet user-secrets set "Email:Password" "your-16-char-app-password" --project src/Services/Inquiry/MTArt.Inquiry.Api
# Docker Development mounts %USERPROFILE%/AppData/Roaming/Microsoft/UserSecrets into inquiry-api.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=yahyabdelali@gmail.com
SMTP_FROM_EMAIL=yahyabdelali@gmail.com
CONTACT_TO_EMAIL=yahyabdelali@gmail.com
SALES_NOTIFICATION_EMAIL=sales@mtart.example.com
